#
# Wrapper that runs the Bazel-pinned Buildifier (@buildifier_prebuilt) from the
# repository root, forwarding all arguments

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"
exec bazel run --ui_event_filters=,+error --noshow_progress -- \
    @buildifier_prebuilt//:buildifier "$@"
